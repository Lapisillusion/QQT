{
  "Urls": "http://127.0.0.1:5080",
  "Match": {
    "PlayerCount": 4,
    "ManualTickAdvance": false,
    "MaxTicks": 500,
    "Seed": null
  },
  "Scenario": {
    "ScriptPath": "scripts/m0.json",
    "TickIntervalMilliseconds": 1000,
    "AnimationMilliseconds": 1000,
    "ReceiveBufferBytes": 4096,
    "MaxScriptTicks": 128,
    "MessageBufferBytes": 16384,
    "MessagePoolRetained": 8,
    "OutgoingQueueCapacity": 64,
    "InitialEventCapacity": 96
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "QQT.Simulation.Tick.Movement": "Debug",
      "QQT.Simulation.Tick.Explosion": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    }
  },
  "Battle": {
    "RecordDirectory": "artifacts/battle"
  },
  "Player": {
    "Speed": 1,
    "BubbleCapacity": 3,
    "BlastRange": 1,
    "VisionRadius": 2,
    "BubbleLifetime": {
      "numerator": 3,
      "denominator": 1
    }
  },
  "Queries": {
    "ActionPoints": 10,
    "BubbleCost": 1,
    "VisiblePlayerCost": 2,
    "OutsidePlayerCost": 3
  },
  "Ui": {
    "CatchUpThreshold": 2,
    "PlaybackSpeed": 1
  },
  "Items": {
    "mode": "random",
    "counts": {
      "speed": 0,
      "capacity": 0,
      "range": 0,
      "vision": 0
    }
  }
}
